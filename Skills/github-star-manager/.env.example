# 推荐放置位置: ~/.gh-star-manager/.env (用户级, 各工作区通用)
# 也可置于 shell 环境变量, 或经 GH_STAR_MANAGER_ENV 指向任意托管密钥文件。
# 优先级: 真实环境变量 > GH_STAR_MANAGER_ENV 文件 > ~/.gh-star-manager/.env > Skill 根目录 .env
# GitHub Personal Access Token (Classic with public_repo, read:user, user scopes)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 整理模式选择: conservative (保守) | moderate (中等, 默认) | aggressive (激进)
STARS_ORGANIZE_MODE=moderate

# 可选精细控制参数（取消注释后可手动覆盖各模式的默认策略与阈值）:
# STARS_STALE_YEARS=2
# STARS_LOW_STARS_THRESHOLD=100
# STARS_UNSTAR_LIMIT=50
# STARS_UNSTAR_SAFE_THRESHOLD=5000
# STARS_AI_SAMPLE_SIZE=60
# STARS_AI_BATCH_SIZE=30
